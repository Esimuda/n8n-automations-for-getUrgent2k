  {
   "id": "55702c92-fff4-475b-9200-627129db97ea",
   "name": "Format Data",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    3080,
    300
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const by={};for(const i of $input.all()){const s=i.json.section;by[s]=by[s]||[];if(!i.json._empty)by[s].push(i.json)}\nreturn [{json:{by,counts:Object.fromEntries(Object.entries(by).map(([k,v])=>[k,v.length]))}}];"
   }
  },
  {
   "id": "9847f707-0ba6-4db3-a6bd-00f7f4191f4d",
   "name": "Brief Draft (template)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    3300,
    300
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const {by,counts}=$json;const n=by['Node Numbers']||[];const sum=k=>n.reduce((a,x)=>a+(x[k]||0),0);\nconst sec=(t,l)=>`*${t}*\\n`+l.map(x=>'• '+x).join('\\n');\nconst g=by['At-Risk Gigs']||[];const p=by['Overdue Payments']||[];const inc=by['Open P1-P2 Incidents']||[];const b=by['New Bugs']||[];const c=by['Inactive Contributors']||[];\nconst text=['📅 Weekly Operating Review (template draft — swap for LLM later)',\nsec('Growth',[`Registrations: ${sum('Registrations')}`,`Verified: ${sum('Verified Contributors')}`,`Contributors on file: ${c.length}`,`At risk/inactive: ${c.filter(x=>['At Risk','Inactive'].includes(x.Segment)).length}`]),\nsec('Marketplace',[`Gigs: ${g.length}`,`Open/filling: ${g.filter(x=>['Published','Filling'].includes(x.Status)).length}`,`Avg fill: ${g.length?Math.round(g.reduce((a,x)=>a+(x['Fill Rate']||0),0)/g.length):0}%`]),\nsec('Financial',[`Payments: ${p.length}`,`Pending: ${p.filter(x=>x.Status==='Pending').length}`,`Paid ₦${p.filter(x=>x.Status==='Paid').reduce((a,x)=>a+(x['Total Amount']||0),0)}`,`Node revenue ₦${sum('Revenue')} / cost ₦${sum('Cost')}`]),\nsec('Product',[`Bugs: ${b.length}`,`Open: ${b.filter(x=>x.Status!=='Fixed').length}`,`Critical/High: ${b.filter(x=>['Critical','High'].includes(x.Severity)).length}`]),\nsec('Network/Nodes',n.map(x=>`${x.City}: ${x['Tasks Completed']}/${x['Tasks Dispatched']} tasks, ${x['Businesses Onboarded']} businesses`)),\nsec('Operations',[`Incidents: ${inc.length}`,`Unresolved: ${inc.filter(x=>x.Status!=='Resolved').length}`])].join('\\n\\n');\nreturn [{json:{text}}];"
   }
  },
