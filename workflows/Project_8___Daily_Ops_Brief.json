  {
   "id": "5fc79f60-9c52-44ab-b29b-3d59ca78cd1a",
   "name": "Format Data",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    3080,
    300
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const by={};for(const i of $input.all()){const s=i.json.section;by[s]=by[s]||[];if(!i.json._empty)by[s].push(i.json)}\nreturn [{json:{by,counts:Object.fromEntries(Object.entries(by).map(([k,v])=>[k,v.length]))}}];"
   }
  },
  {
   "id": "5cd55fd1-d812-4230-ba17-4144ce0428a2",
   "name": "Brief Draft (template)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    3300,
    300
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const {by,counts}=$json;const crit=[],att=[],ok=[];\n(by['Open P1-P2 Incidents']||[]).forEach(x=>crit.push(`${x.Severity} incident: ${x.Description}`));\n(by['Overdue Payments']||[]).forEach(x=>crit.push(`Overdue payment #${x['Payment ID']} ₦${x['Total Amount']}`));\n(by['At-Risk Gigs']||[]).forEach(x=>att.push(`Low fill: ${x.Title} (${Math.round(x['Fill Rate']||0)}%)`));\n(by['New Bugs']||[]).forEach(x=>att.push(`New bug (${x.Severity}): ${x.Feature}`));\nif(counts['Inactive Contributors'])att.push(`${counts['Inactive Contributors']} contributors at risk/inactive`);\n(by['Node Numbers']||[]).forEach(x=>ok.push(`${x.City}: ${x['Tasks Completed']}/${x['Tasks Dispatched']} tasks`));\nconst s=a=>a.length?a.map(x=>'• '+x).join('\\n'):'• None';\nreturn [{json:{text:`☀️ Daily Ops Brief (template draft — swap for LLM later)\\n\\n🔴 Critical\\n${s(crit)}\\n\\n🟡 Attention\\n${s(att)}\\n\\n🟢 Healthy\\n${s(ok)}`}}];"
   }
  },
