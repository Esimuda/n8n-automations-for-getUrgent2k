  {
   "id": "76f7a56b-8748-4f85-8981-926ff8694444",
   "name": "Reconcile",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const key=f=>`${(f.Gig||[])[0]}|${(f.Contributor||[])[0]}`;\nconst subs=$('Passed Submissions').all().filter(i=>i.json.id).map(i=>key((i.json.fields||i.json)));\nconst pays=$('All Payments').all().filter(i=>i.json.id).map(i=>key((i.json.fields||i.json)));\nconst cnt={};pays.forEach(k=>cnt[k]=(cnt[k]||0)+1);\nconst noPay=subs.filter(k=>!pays.includes(k)),noPass=[...new Set(pays.filter(k=>!subs.includes(k)))],dups=Object.keys(cnt).filter(k=>cnt[k]>1);\nreturn [{json:{noPay,noPass,dups,text:`🧾 Reconciliation: ${subs.length} passed / ${pays.length} payments\\nPass w/o payment: ${noPay.length}\\nPayment w/o pass: ${noPass.length}\\nDuplicates: ${dups.length}`}}];"
   }
  },
