   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const f=($input.first().json.fields||$input.first().json);const n=f['Sample Size Requested']||0;const target=Math.ceil(n*1.25);\nconst ev={'Mystery Shopping':'receipt photo, storefront photo, timed visit notes','Interview':'audio recording + consent, transcript notes','Market Observation':'geotagged photos, price/shelf log','Retailer Verification':'storefront photo with GPS, owner contact, shelf photo','UGC':'original video/photo, usage rights consent'}[f.Method]||'photo evidence + notes';\nconst days=Math.max(3,Math.ceil(target/10)+2);const risk=n>100?'high':n>40?'medium':'low';\nconst why={high:'large sample relative to one-city contributor pool',medium:'moderate sample; may need cross-city recruiting',low:'small sample, well within node capacity'}[risk];\nreturn [{json:{id:$input.first().json.id,draft:`[Template draft — swap for LLM later] Recruit ${target} (${n} + 25% buffer) in ${f.Location||'TBD'} via ${f.Method||'TBD'}. Evidence: ${ev}. Est. duration: ${days} days. Risk: ${risk} — ${why}.`}}];"
   }
