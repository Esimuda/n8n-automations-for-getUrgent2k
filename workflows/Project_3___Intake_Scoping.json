   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "// Flatten Tally payload {data:{fields:[{label,value,options}]}} or plain JSON\nfunction flat(b){ if(b&&b.data&&Array.isArray(b.data.fields)){const o={};for(const f of b.data.fields){let v=f.value;if(Array.isArray(v)&&f.options){v=v.map(id=>(f.options.find(x=>x.id===id)||{}).text||id);if(f.type==='DROPDOWN'||f.type==='MULTIPLE_CHOICE')v=v[0];}o[f.label]=v;}return o;} return b||{}; }\n\nconst d=flat($input.first().json.body||$input.first().json);const num=v=>Number(String(v||0).replace(/[^0-9.]/g,''))||0;\nreturn [{json:{'Client Name':d['Client Name']||'','Research Objective':d['Research Objective']||'',Location:d['Location']||'','Sample Size Requested':num(d['Sample Size Requested']),'Target Audience':d['Target Audience']||'',Method:d['Method']||'',Deadline:d['Deadline']||null,'Compensation Budget':num(d['Compensation Budget']),'Evidence Requirements':d['Evidence Requirements']||''}}];"
   }
  },
