    440,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "return items.map(item=>{const f=(item.json.fields||item.json);const fr=f['Fill Rate']||0;const h=(new Date(f['Deadline'])-new Date())/36e5;let level='ok';\nif(h<=0)level='passed';else if(h<=24&&fr<80)level='escalate';else if(h<=72&&fr<60)level='warn';\nreturn {json:{id:item.json.id,title:f.Title,level,fill:Math.round(fr),source:'Failed Workflow',severity:'P2',description:`Gig \"${f.Title}\" deadline passed at ${Math.round(fr)}% fill (gig ${item.json.id}).`}}});"
   }
  },
