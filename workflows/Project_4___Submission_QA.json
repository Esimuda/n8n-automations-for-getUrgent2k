   "name": "Normalize Tally",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "// Flatten Tally payload {data:{fields:[{label,value,options}]}} or plain JSON\nfunction flat(b){ if(b&&b.data&&Array.isArray(b.data.fields)){const o={};for(const f of b.data.fields){let v=f.value;if(Array.isArray(v)&&f.options){v=v.map(id=>(f.options.find(x=>x.id===id)||{}).text||id);if(f.type==='DROPDOWN'||f.type==='MULTIPLE_CHOICE')v=v[0];}o[f.label]=v;}return o;} return b||{}; }\n\nconst d=flat($input.first().json.body||$input.first().json);\nconst ev=d['Evidence']||d['Evidence upload']||d.evidence;const evUrl=Array.isArray(ev)?(ev[0]&&ev[0].url):ev;\nreturn [{json:{gigId:(d['Gig ID']||d.gigId||'').trim(),contributorId:(d['Contributor ID']||d.contributorId||'').trim(),evidence:evUrl||'',notes:d['Notes']||d.notes||''}}];"
   }
  },
