   "name": "QA Checks",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1320,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const n=$('QA Input').first().json;const raw=$input.first().json;const gig=raw.fields||raw;\nconst checks={hasEvidence:!!n.evidence,withinDeadline:!gig['Deadline']||new Date().toISOString().slice(0,10)<=gig['Deadline']};\nlet status='Pass';if(!checks.hasEvidence)status='Major Issue';else if(!checks.withinDeadline)status='Suspicious';else if(!n.notes)status='Minor Issue';\nreturn [{json:{id:n.id,status,checks,gigId:n.gigId,contributorId:n.contributorId,compensation:gig['Compensation']||0,gigTitle:gig.Title,city:gig.City,type:gig.Type}}];"
   }
