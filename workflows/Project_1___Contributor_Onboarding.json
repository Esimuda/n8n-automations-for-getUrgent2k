   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "// Flatten Tally payload {data:{fields:[{label,value,options}]}} or plain JSON\nfunction flat(b){ if(b&&b.data&&Array.isArray(b.data.fields)){const o={};for(const f of b.data.fields){let v=f.value;if(Array.isArray(v)&&f.options){v=v.map(id=>(f.options.find(x=>x.id===id)||{}).text||id);if(f.type==='DROPDOWN'||f.type==='MULTIPLE_CHOICE')v=v[0];}o[f.label]=v;}return o;} return b||{}; }\n\nconst d=flat($input.first().json.body||$input.first().json);\nreturn [{json:{Name:d['Name']||d['Full Name']||'',Phone:d['Phone']||'',Email:d['Email']||'',City:d['City']||'',Skills:d['Skills']||'',Availability:d['Availability']||'','Experience Level':d['Experience Level']||'','Payment Info Provided':!!d['Payment Info Provided'],Status:'Active','Verification Status':'Pending','Date Registered':new Date().toISOString().slice(0,10),'Last Active Date':new Date().toISOString().slice(0,10)}}];"
   }
