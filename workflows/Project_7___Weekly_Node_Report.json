   "name": "Metrics",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "return items.map(item=>{const f=(item.json.fields||item.json);\nconst activation=f['Registrations']?Math.round((f['Verified Contributors']/f['Registrations'])*100):0;\nconst completion=f['Tasks Dispatched']?Math.round((f['Tasks Completed']/f['Tasks Dispatched'])*100):0;\nconst productivity=f['Cost']?Number((f['Tasks Completed']/f['Cost']*1000).toFixed(2)):0;\nreturn {json:{id:item.json.id,city:f.City,activation,completion,productivity,margin:(f.Revenue||0)-(f.Cost||0),priorActivation:f['Prior Week Activation %']??null,priorCompletion:f['Prior Week Completion %']??null}}});"
   }
  },
  {
   "id": "462c7766-904e-49cb-8fba-aaed95ac8e03",
   "name": "Build Report",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const l=$input.all().map(i=>`${i.json.city}: activation ${i.json.activation}%, completion ${i.json.completion}%, tasks/₦1k ${i.json.productivity}, margin ₦${i.json.margin}`);return [{json:{text:'📊 Weekly Node Report\\n'+l.join('\\n')}}];"
   }
  },
