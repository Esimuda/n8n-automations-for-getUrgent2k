   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const F=['Name','Phone','Email','City','Skills','Availability','Experience Level','Payment Info Provided'];\nreturn items.map(i=>{const f=(i.json.fields||i.json);const have=F.filter(k=>{const v=f[k];return Array.isArray(v)?v.length>0:!!v}).length;const score=Math.round(have/F.length*100);const missing=F.filter(k=>{const v=f[k];return !(Array.isArray(v)?v.length:v)});return {json:{id:i.json.id,name:f.Name,score,missing:missing.join(', ')}}});"
   }
